flow: Context delivery {
  shape: sequence_diagram
  user: Neovim user
  nvim: Neovim
  plugin: herdr-context.nvim
  herdr: Herdr CLI
  agent: Coding agent

  user -> nvim: run mapping or command
  nvim -> plugin: file, selection, diagnostics, list, or messages
  plugin -> herdr: list agents in workspace
  herdr -> plugin: matching agents
  plugin -> user: choose when several match
  user -> plugin: selected agent
  plugin -> plugin: format context for the agent input
  plugin -> herdr: place text in target pane
  herdr -> agent: insert text without submitting
  herdr -> plugin: placement succeeded
  plugin -> herdr: focus target agent
  herdr -> user: show agent input
}
