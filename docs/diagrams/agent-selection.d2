direction: right
current: Current tab
currentOne: One agent → send
currentMany: Several agents → pick one → send
workspace: Current workspace
workspaceOne: One agent → send
workspaceMany: Several agents → pick one → send
warning: No agent → warning, nothing sent
current -> currentOne
current -> currentMany
current -> workspace: no agent
workspace -> workspaceOne
workspace -> workspaceMany
workspace -> warning
